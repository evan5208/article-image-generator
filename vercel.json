{
  "version": 2,
  "builds": [
    { "src": "api/*.js", "use": "@vercel/node" }
  ],
  "routes": [
    { "src": "/api/models", "dest": "/api/models.js" },
    { "src": "/api/generate", "dest": "/api/generate.js" },
    { "src": "/api/health", "dest": "/api/health.js" },
    { "src": "/", "dest": "/index.html" },
    { "src": "/index.html", "dest": "/index.html" },
    { "src": "/(.*)", "dest": "/index.html" }
  ]
}
